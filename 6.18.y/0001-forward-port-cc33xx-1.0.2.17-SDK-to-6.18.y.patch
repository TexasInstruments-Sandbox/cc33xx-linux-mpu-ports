+/*
+ * cc33xx firmware's channel_type field only encodes HT20/HT40+/- (see
+ * enum cc33xx_channel_type); cfg80211_get_chandef_type() WARN_ON()s on
+ * anything wider (80/160 MHz etc.), which VHT/HE connections can produce.
+ * Collapse those to the HT40 direction of the primary channel instead.
+ */
+static enum nl80211_channel_type
+cc33xx_get_chandef_ht_type(const struct cfg80211_chan_def *chandef)
+{
+	switch (chandef->width) {
+	case NL80211_CHAN_WIDTH_20_NOHT:
+		return NL80211_CHAN_NO_HT;
+	case NL80211_CHAN_WIDTH_20:
+		return NL80211_CHAN_HT20;
+	default:
+		return chandef->center_freq1 > chandef->chan->center_freq ?
+			NL80211_CHAN_HT40PLUS : NL80211_CHAN_HT40MINUS;
+	}
+}
