diff --git a/drivers/net/wireless/ti/cc33xx/debugfs.c b/drivers/net/wireless/ti/cc33xx/debugfs.c
index 71d760492079..fc500b624629 100644
--- a/drivers/net/wireless/ti/cc33xx/debugfs.c
+++ b/drivers/net/wireless/ti/cc33xx/debugfs.c
@@ -1386,7 +1386,22 @@ static loff_t dev_mem_seek(struct file *file, loff_t offset, int orig)
 	if (offset % 4)
 		return -EINVAL;
 
-	return no_seek_end_llseek(file, offset, orig);
+	loff_t ret;
+	
+	switch (orig) {
+	case SEEK_SET:
+		file->f_pos = offset;
+		ret = file->f_pos;
+		break;
+	case SEEK_CUR:
+		file->f_pos += offset;
+		ret = file->f_pos;
+		break;
+	default:
+		ret = -EINVAL;
+	}
+
+	return ret;
 }
 
